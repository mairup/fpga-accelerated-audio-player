digraph FPGA {
  rankdir=LR;
  graph [splines=ortho, bgcolor=transparent, nodesep=0.5, ranksep=0.8, fontname=Helvetica];
  node [shape=box, style="filled,rounded", fillcolor=white, color=black, fontname=Helvetica, fontsize=11, penwidth=1];
  edge [color=black, fontname=Helvetica, fontsize=9, arrowsize=0.7];

  subgraph cluster_TopAudioAccelerator {
    label="TopAudioAccelerator"; labeljust=l;
    style="filled,rounded"; fillcolor=white; color=black;
    fontname=Helvetica; fontsize=11;
    subgraph cluster_audioPipeline {
      label="AudioPipeline"; labeljust=l;
      style="filled,rounded"; fillcolor=white; color=black;
      fontname=Helvetica; fontsize=11;
      chorus [label="Chorus"];
      overdrive [label="Overdrive"];
      tremolo [label="Tremolo"];
    }
    dac [label="SigmaDeltaDAC"];
    i2sController [label="I2sController"];
    matrixVisualizer [label="LedMatrixVisualizer"];
    visualizer [label="VisualizerTop"];
  }

  audioPipeline -> dac [xlabel="sampleOut\nSInt(32.W)"];
  chorus -> tremolo [xlabel="sampleOut\nSInt(32.W)"];
  i2sController -> audioPipeline [xlabel="pcmRx\nSInt(32.W)"];
  i2sController -> visualizer [xlabel="pcmRx\nSInt(32.W)"];
  overdrive -> chorus [xlabel="sampleOut\nSInt(32.W)"];
  visualizer -> matrixVisualizer [xlabel="catVolume\nVec(8, UInt(24.W))"];
}
